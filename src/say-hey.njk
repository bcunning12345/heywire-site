---
layout: layouts/base.njk
title: Say HEY for a quote
description: Get a fixed-price quote for low-voltage cabling, usually the same day. Four questions, a few minutes, site plans welcome.
---
<section class="page-head page-head--tight">
  <div class="container">
    <p class="eyebrow">Say HEY</p>
    <h1 class="h1">Tell us what you need.</h1>
    <p class="lede">Four questions about the job, two about you. A fixed price comes back in writing, usually the same day.</p>
  </div>
</section>

<section class="section section--tight">
  <div class="container quote-page">
    <form class="quote-form card" id="quote-form" data-endpoint="{{ site.quoteEndpoint or '' }}" data-contact="{{ site.email }}" novalidate>
      <fieldset class="quote-form__group">
        <legend class="eyebrow">The job</legend>
        <label class="field">
          <span class="field__label">Property type</span>
          <select class="field__input" name="property" required>
            {% for p in site.propertyTypes %}<option>{{ p }}</option>{% endfor %}
          </select>
        </label>
        <label class="field">
          <span class="field__label">What needs wiring</span>
          <select class="field__input" name="service" required>
            {% for s in site.services %}<option value="{{ s.slug }}">{{ s.title }}</option>{% endfor %}
          </select>
        </label>
        <div class="field-row">
          <label class="field">
            <span class="field__label">How many</span>
            <input class="field__input" type="number" name="quantity" min="1" placeholder="24" inputmode="numeric" required>
          </label>
          <label class="field">
            <span class="field__label">Property ZIP code <span class="field__opt">US only</span></span>
            <input class="field__input" type="text" name="zip" placeholder="85004" inputmode="numeric" autocomplete="postal-code" pattern="\d{5}(-\d{4})?" maxlength="10" required>
            <span class="field__area" aria-live="polite"></span>
          </label>
        </div>
        <label class="field">
          <span class="field__label">When</span>
          <select class="field__input" name="timing">
            <option>As soon as possible</option>
            <option>Within 30 days</option>
            <option>Planning for later this year</option>
            <option>Just pricing for now</option>
          </select>
        </label>
        <label class="field">
          <span class="field__label">Anything else <span class="field__opt">optional</span></span>
          <textarea class="field__input field__input--area" name="notes" rows="3" placeholder="Floors, ceiling type, deadlines, a property list, or what the last contractor left behind."></textarea>
        </label>
        <div class="field">
          <span class="field__label" id="files-label">Site plans or drawings <span class="field__opt">optional</span></span>
          <label class="dropzone" for="quote-files">
            <input class="dropzone__input" type="file" id="quote-files" name="files" multiple accept=".pdf,.png,.jpg,.jpeg,.heic,.webp,.dwg,.dxf,.vsdx,.zip" aria-describedby="files-help">
            <span class="dropzone__icon" aria-hidden="true">{% include "svg/icon-upload.svg" %}</span>
            <span class="dropzone__text"><strong>Add files</strong> or drop them here</span>
            <span class="dropzone__help" id="files-help">Floor plans, marked-up PDFs, photos of the closet, or a CAD file. Up to 10 files, 25 MB total.</span>
          </label>
          <ul class="file-list" id="file-list" aria-live="polite"></ul>
        </div>
        <label class="field field--check">
          <input class="field__check" type="checkbox" name="asbuilt" value="yes">
          <span><strong>Add as-built drawings</strong> <span class="field__opt">optional add-on</span><br><span class="field__hint">Marked-up plans showing every run, jack, and port. Priced per floor on the quote.</span></span>
        </label>
      </fieldset>

      <fieldset class="quote-form__group">
        <legend class="eyebrow">You</legend>
        <div class="field-row">
          <label class="field">
            <span class="field__label">Name</span>
            <input class="field__input" type="text" name="name" autocomplete="name" required>
          </label>
          <label class="field">
            <span class="field__label">Property or company</span>
            <input class="field__input" type="text" name="company" autocomplete="organization">
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span class="field__label">Email</span>
            <input class="field__input" type="email" name="email" autocomplete="email" required>
          </label>
          <label class="field">
            <span class="field__label">Phone</span>
            <input class="field__input" type="tel" name="phone" autocomplete="tel">
          </label>
        </div>
      </fieldset>

      <div class="quote-form__actions">
        {% if site.turnstileSiteKey %}
        <div class="captcha">
          <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-theme="light" data-size="flexible" data-action="say-hey"></div>
        </div>
        {% endif %}
        <button class="btn btn--primary btn--large btn--block" type="submit">Say HEY {% include "svg/arrow.svg" %}</button>
        <p class="quote-form__status" id="quote-status" role="status" aria-live="polite"></p>
        <p class="muted">By sending, you agree we can contact you about this job. Nothing else, no lists, our promise!</p>
      </div>
    </form>

    <div class="quote-done card" id="quote-done" hidden>
      <div class="quote-done__mark">{% include "svg/mark-color.svg" %}</div>
      <h2 class="h2" id="quote-done-title">You said HEY.</h2>
      <p class="lede" id="quote-done-lede">We have the job. A fixed price lands in your inbox, usually the same day. Complex projects take until the next day, and anything unusual gets a call first.</p>
      <div class="summary" id="quote-summary"></div>
      <p class="muted" id="quote-done-note">Need to change something? Reply to the quote email{% if site.phone %}, or call <a href="{{ site.phoneHref }}">{{ site.phone }}</a>{% endif %}.</p>
      <a class="link-arrow" href="/">Back to the home page</a>
    </div>

    <aside class="quote-aside">
      <div class="card">
        <p class="eyebrow">What happens next</p>
        <ol class="mini-steps">
          {% for step in site.steps %}<li><strong>{{ step.title }}.</strong> {{ step.text }}</li>{% endfor %}
        </ol>
      </div>
      <div class="card">
        <p class="eyebrow">Where we're live</p>
        <ul class="area-list area-list--compact">
          {% for a in site.serviceAreas %}<li><span>{{ a.name }}</span><span class="pill{% if a.status != 'live' %} pill--soon{% endif %}">{% if a.status == 'live' %}Live{% else %}Coming soon{% endif %}</span></li>{% endfor %}
        </ul>
        <p class="muted">Somewhere else? Say HEY anyway and you are first in line when crews are live there.</p>
      </div>
      <div class="card">
        <p class="eyebrow">{% if site.phone %}Rather talk?{% else %}Rather email?{% endif %}</p>
        <p class="card__text">{% if site.phone %}<a class="link-arrow" href="{{ site.phoneHref }}">{{ site.phone }}</a><br>{% endif %}<a class="link-arrow" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p class="muted">{% if site.phone %}Days, nights, and weekends. If we are on a ladder, we call back within the hour.{% else %}Send the job in plain words and we will price it by hand. Days, nights, and weekends.{% endif %}</p>
      </div>
    </aside>
  </div>
</section>
