<div class="quote-card">
  <div class="quote-card__head">
    <h2 class="quote-card__title">Quick quote</h2>
    <span class="pill">Usually same day</span>
  </div>
  <form class="quote-card__form" action="/say-hey/" method="get">
    <label class="field">
      <span class="field__label">Property type</span>
      <select class="field__input" name="property">
        {% for p in site.propertyTypes %}<option>{{ p }}</option>{% endfor %}
      </select>
    </label>
    <label class="field">
      <span class="field__label">What needs wiring</span>
      <select class="field__input" name="service">
        {% for s in site.services %}<option value="{{ s.slug }}">{{ s.title }}</option>{% endfor %}
      </select>
    </label>
    <div class="field-row">
      <label class="field">
        <span class="field__label">How many</span>
        <input class="field__input" type="number" name="quantity" min="1" placeholder="24" inputmode="numeric">
      </label>
      <label class="field">
        <span class="field__label">ZIP code <span class="field__opt">US only</span></span>
        <input class="field__input" type="text" name="zip" placeholder="85004" inputmode="numeric" autocomplete="postal-code" pattern="\d{5}(-\d{4})?" maxlength="10">
        <span class="field__area" aria-live="polite"></span>
      </label>
    </div>
    <button class="btn btn--primary btn--block" type="submit">Say HEY {% include "svg/arrow.svg" %}</button>
    <p class="quote-card__note">A fixed price in writing, usually the same day. Next day for complex projects. No site walk for standard jobs.</p>
  </form>
</div>
