<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Just Say HEY · Coming soon</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#6D3BE0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/icons/heywire-app-icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/icons/heywire-app-icon-180.png">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="Just Say HEY · Coming soon">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <style>
    @font-face { font-family: "Archivo"; font-weight: 400; font-display: swap; src: url("/assets/fonts/Archivo-Regular.ttf") format("truetype"); }
    @font-face { font-family: "Archivo"; font-weight: 500; font-display: swap; src: url("/assets/fonts/Archivo-Medium.ttf") format("truetype"); }
    @font-face { font-family: "Archivo"; font-weight: 900; font-display: swap; src: url("/assets/fonts/Archivo-Black.ttf") format("truetype"); }

    :root { --violet: #6D3BE0; --plum: #2A1A4A; --bone: #F4EFE6; --lilac: #B9A0F5; --white: #FFFFFF; }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; min-height: 100%;
      font-family: "Archivo", "Helvetica Neue", Arial, sans-serif; color: var(--bone);
      background: var(--violet);
      display: flex; flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    .hold { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 6vh, 72px) clamp(22px, 6vw, 96px); }
    .hold__inner { width: 100%; max-width: 1040px; margin: 0 auto; display: flex; flex-direction: column; gap: clamp(26px, 4vh, 44px); }

    .lockup { width: min(100%, 520px); height: auto; display: block; overflow: visible; }
    .eyebrow { margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; color: var(--lilac); }
    .h1 { margin: 0; font-weight: 900; font-size: clamp(40px, 7.2vw, 88px); line-height: 0.96; letter-spacing: -0.03em; color: var(--white); max-width: 14ch; }
    .lede { margin: 0; font-size: clamp(17px, 1.8vw, 21px); line-height: 1.5; max-width: 56ch; color: var(--bone); opacity: 0.92; }
    .lede strong { font-weight: 500; color: var(--white); }

    .actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 26px; border-radius: 12px;
      background: var(--bone); color: var(--plum); font-size: 16px; font-weight: 700; letter-spacing: 0.02em; text-decoration: none;
      transition: transform 0.15s ease, background-color 0.15s ease;
    }
    .btn:hover { background: var(--white); transform: translateY(-1px); }
    .btn svg { flex: none; }
    .hint { margin: 0; font-size: 14px; line-height: 1.5; color: var(--lilac); max-width: 40ch; }

    .foot { padding: 22px clamp(22px, 6vw, 96px) 28px; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--lilac); }
    .foot a { text-decoration: none; }
    .foot a:hover { color: var(--white); }

    /* The cable pulls in from the call-out, then the pairs fan out. */
    .lockup > path:nth-of-type(1), .lockup > path:nth-of-type(4) { animation: pop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both; transform-origin: 60px 150px; }
    /* These two carry SVG transform attributes, so they may only fade, never move. */
    .lockup > path:nth-of-type(2), .lockup > path:nth-of-type(3) { animation: fade 0.7s ease-out 0.35s both; }
    .lockup > path:nth-of-type(5) { stroke-dasharray: 400; stroke-dashoffset: 400; animation: pull 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.55s forwards; }
    .lockup > rect, .lockup > path:nth-of-type(n+6) { opacity: 0; animation: fan 0.5s ease-out 1.5s forwards; transform-origin: 430px 188px; }
    .eyebrow, .h1, .lede { animation: rise 0.7s ease-out both; }
    .eyebrow { animation-delay: 0.9s; } .h1 { animation-delay: 1.05s; } .lede { animation-delay: 1.2s; }

    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes pop { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pull { to { stroke-dashoffset: 0; } }
    @keyframes fan { from { opacity: 0; transform: scaleX(0.6); } to { opacity: 1; transform: scaleX(1); } }

    @media (prefers-reduced-motion: reduce) {
      .lockup > *, .eyebrow, .h1, .lede { animation: none !important; opacity: 1 !important; stroke-dashoffset: 0 !important; }
    }
  </style>
</head>
<body>
  <main class="hold">
    <div class="hold__inner">
      {{ content | safe }}
    </div>
  </main>
  <footer class="foot">
    <span>By {{ site.parent | replace(" LLC", "") }}</span>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </footer>
</body>
</html>
